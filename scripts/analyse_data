step_two() {
    local input_path="$1"
    mkdir -p D2_applyJEScorrections
    submit applyJEScorrections D1_mergeNtuples D2_applyJEScorrections $PWD/$SCHOOL_EOS/Run3-26Prompt-Summer24-NanoAODv15/jet_jerc.json.gz $JES_CORRECTION_TAG -N 5000000 -b -F
}

main() {
    local input_path="$1"

    # step_one "$input_path"
    step_two "$input_path"
}

if [[ $# -lt 1 ]]; then
    printf 'Usage: %s <input_path>\n' "$0" >&2
    exit 1
fi

