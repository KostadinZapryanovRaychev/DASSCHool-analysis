#!/usr/bin/env bash

set -u
set -o pipefail

YOUR_DATASET="/eos/cms/store/group/phys_smp/ec/DAS/0071/D0_mkNtuples/LowPU/JetMET4/"
SCHOOL_EOS="/eos/user/k/kraychev/DASSChool2026/long-ex/first_r_analysis/long-ex-smp-jet"
JES_CORRECTION_TAG="Summer24Prompt26_V1"
LOW_PU_LUMI="/eos/user/k/kraychev/DASSChool2026/long-ex/first_r_analysis/long-ex-smp-jet/D0_mkNtuples/LowPU.info"
TURNONS_ROOT="/eos/user/k/kraychev/DASSChool2026/long-ex/first_r_analysis/long-ex-smp-jet/TriggerCurves/turnons.root"
TURNONS_TXT="/eos/user/k/kraychev/DASSChool2026/long-ex/first_r_analysis/long-ex-smp-jet/TriggerCurves/turnons.txt"
OBSERVABLES="$DAS_BASE/tools/lib64/plugins/SMP_26_017/libJetPtY.so"

# Step 1: merge ntuples
mkdir D1_mergeNtuples
submit mergeNtuples -F "$YOUR_DATASET" D1_mergeNtuples /dev/null /dev/null

# Step 2: apply JES corrections
mkdir -p D2_applyJEScorrections
submit applyJEScorrections D1_mergeNtuples D2_applyJEScorrections "$SCHOOL_EOS/Run3-26Prompt-Summer24-NanoAODv15/jet_jerc.json.gz" "$JES_CORRECTION_TAG" -N 5000000 -b -F

# Step 3a: get trigger curves
mkdir -p TriggerCurves
submit getTriggerCurves D2_applyJEScorrections TriggerCurves "$LOW_PU_LUMI" true -b -N 5000000

# Step 3b: apply data normalisation
mkdir -p D3_applyDataNormalisation
submit -b -N 5000000 -F applyDataNormalisation D2_applyJEScorrections D3_applyDataNormalisation "$LOW_PU_LUMI" /dev/null "$TURNONS_TXT" "$TURNONS_ROOT" pt prescales

# Step 4: get unfolded global distributions
mkdir -p D4_applyUnf
submit -b -N 5000000 -F getUnfGlobalDist D3_applyDataNormalisation D4_applyUnf true "$OBSERVABLES"
