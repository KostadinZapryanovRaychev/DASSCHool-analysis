#!/usr/bin/env bash

# Run sequential commands and pass each step's output to the next step.
# Replace the example step functions with the commands for your workflow.

set -u
set -o pipefail

STEP_RESULT=""

run_step() {
    local step_name="$1"
    shift
    local output
    local status

    printf '\n==> %s\n' "$step_name"
    printf 'Command:'
    printf ' %q' "$@"
    printf '\n'

    if output="$("$@")"; then
        STEP_RESULT="$output"
        printf '%s\n' "$STEP_RESULT"
    else
        status=$?
        printf 'ERROR: %s failed with exit code %d\n' "$step_name" "$status" >&2
        return "$status"
    fi
}

step_one() {
    local input_path="$1"
    parallel mergeNtuples -F "$input_path" D1_mergeNtuples/ D1_mergeNtuples /dev/null /dev/null
}

step_two() {
    local previous_result="$1"
    printf '%s -> processed by step two\n' "$previous_result"
}

step_three() {
    local previous_result="$1"
    printf '%s -> processed by step three\n' "$previous_result"
}

main() {
    local input_path="$1"
    local previous_result

    run_step "Step 1" step_one "$input_path" || return $?
    previous_result="$STEP_RESULT"

    run_step "Step 2" step_two "$previous_result" || return $?
    previous_result="$STEP_RESULT"

    run_step "Step 3" step_three "$previous_result" || return $?

    printf '\nAll steps completed successfully.\n'
}

if [[ $# -lt 1 ]]; then
    printf 'Usage: %s <input_path>\n' "$0" >&2
    exit 1
fi

main "$1" || {
    exit_code=$?
    printf 'Workflow stopped.\n' >&2
    exit "$exit_code"
}
