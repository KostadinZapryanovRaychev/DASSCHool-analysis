#!/usr/bin/env zsh

set -u
set -o pipefail

YOUR_DATASET="/eos/cms/store/group/phys_smp/ec/DAS/0071/D0_mkNtuples/LowPU/"
SCHOOL_EOS="/eos/user/k/kraychev/DASSChool2026/long-ex/first_r_analysis/long-ex-smp-jet"
JES_CORRECTION_TAG="Summer24Prompt26_V1"
LOW_PU_LUMI="/eos/user/k/kraychev/DASSChool2026/long-ex/first_r_analysis/long-ex-smp-jet/D0_mkNtuples/LowPU.info"
TURNONS_ROOT="/eos/user/k/kraychev/DASSChool2026/long-ex/first_r_analysis/long-ex-smp-jet/TriggerCurves/turnons.root"
TURNONS_TXT="/eos/user/k/kraychev/DASSChool2026/long-ex/first_r_analysis/long-ex-smp-jet/TriggerCurves/turnons.txt"
OBSERVABLES="$DAS_BASE/tools/lib64/plugins/SMP_26_017/libJetPtY.so"

for sample in JetMET4; do
    mkdir -p D1_mergeNtuples/$sample
    submit mergeNtuples -F "$YOUR_DATASET/$sample" D1_mergeNtuples/$sample /dev/null /dev/null

    mkdir -p D2_applyJEScorrections/$sample
    submit -N 5000000 -F applyJEScorrections D1_mergeNtuples/$sample D2_applyJEScorrections/$sample "$SCHOOL_EOS/Run3-26Prompt-Summer24-NanoAODv15/jet_jerc.json.gz" "$JES_CORRECTION_TAG"

    mkdir -p TriggerCurves/$sample
    submit -N 5000000 getTriggerCurves D2_applyJEScorrections/$sample TriggerCurves/$sample "$LOW_PU_LUMI" true

    mkdir -p D3_applyDataNormalisation/$sample
    submit -N 5000000 -F applyDataNormalisation D2_applyJEScorrections/$sample D3_applyDataNormalisation/$sample "$LOW_PU_LUMI" /dev/null "$TURNONS_TXT" "$TURNONS_ROOT" pt prescales

    mkdir -p D4_applyUnf/$sample
    submit -N 5000000 getUnfGlobalDist D3_applyDataNormalisation/$sample D4_applyUnf/$sample true "$OBSERVABLES"
done