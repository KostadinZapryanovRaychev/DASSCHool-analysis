#!/usr/bin/env bash


set -u
set -o pipefail

run_step() {
    local step_name="$1"
    shift
    local status
    printf ' %q' "$@"
    printf '\n'

    if "$@"; then
        return 0
    else
        status=$?
        printf 'ERROR: %s failed with exit code %d\n' "$step_name" "$status" >&2
        return "$status"
    fi
}

step_one() {
    local input_path="$1"
    mkdir D1_mergeNtupless
    submit mergeNtuples -F "$input_path" D1_mergeNtupless /dev/null /dev/null -b
}



main() {
    local input_path="$1"

    run_step "Merging N Tuples" step_one "$input_path" || return $?
    printf '\nAll steps completed successfully.\n'
}

if [[ $# -lt 1 ]]; then
    printf 'Usage: %s <input_path>\n' "$0" >&2
    exit 1
fi

main "$1" || {
    exit_code=$?
    printf 'Workflow stopped.\n' >&2
    exit "$exit_code"
}
