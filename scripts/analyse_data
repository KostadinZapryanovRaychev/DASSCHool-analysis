#!/usr/bin/env bash

# Run sequential commands, each operating on its own named inputs/outputs
# (files/directories) rather than passing big data between steps as strings.
# Replace the example step functions with the commands for your workflow.

set -u
set -o pipefail

run_step() {
    local step_name="$1"
    shift
    local status

    printf '\n==> %s\n' "$step_name"
    printf 'Command:'
    printf ' %q' "$@"
    printf '\n'

    if "$@"; then
        return 0
    else
        status=$?
        printf 'ERROR: %s failed with exit code %d\n' "$step_name" "$status" >&2
        return "$status"
    fi
}

step_one() {
    local input_path="$1"
    submit mergeNtuples -F "$input_path" D1_mergeNtuples /dev/null /dev/null
}

step_two() {
    local merged_dir="D1_mergeNtuples"
    printf 'processing %s in step two\n' "$merged_dir"
}

step_three() {
    local merged_dir="D1_mergeNtuples"
    printf 'processing %s in step three\n' "$merged_dir"
}

main() {
    local input_path="$1"

    run_step "Merging N Tuples" step_one "$input_path" || return $?
    run_step "Step 2" step_two || return $?
    run_step "Step 3" step_three || return $?

    printf '\nAll steps completed successfully.\n'
}

if [[ $# -lt 1 ]]; then
    printf 'Usage: %s <input_path>\n' "$0" >&2
    exit 1
fi

main "$1" || {
    exit_code=$?
    printf 'Workflow stopped.\n' >&2
    exit "$exit_code"
}
